<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <!-- Fleet Asset Category -->
    <record id="module_category_fleet_asset" model="ir.module.category">
        <field name="name">Fleet Asset</field>
        <field name="description"> Fleet Asset Category</field>
        <field name="sequence">20</field>
    </record>

    <!-- Fleet Asset Privilege -->
    <record id="group_privilege_fleet_asset" model="res.groups.privilege">
        <field name="name">Fleet Asset</field>
        <field name="description"> Fleet Asset Group Privilege</field>
        <field name="category_id" ref="fleet_maintenance.module_category_fleet_asset" />
        <field name="sequence">20</field>
    </record>

    <!-- Fleet Asset User Group -->
    <record id="group_fleet_asset_user" model="res.groups">
        <field name="name">User: Fleet Asset</field>
        <field name="privilege_id" ref="fleet_maintenance.group_privilege_fleet_asset" />
        <field name="sequence">20</field>
        <field name="implied_by_ids" eval="[(4, ref('base.group_user'))]" />
        <field name="user_ids" eval="[(4, ref('base.user_demo'))]" />
    </record>

    <!-- Fleet Asset Manager Group -->
    <record id="group_fleet_asset_manager" model="res.groups">
        <field name="name">Manager: Fleet Asset</field>
        <field name="privilege_id" ref="fleet_maintenance.group_privilege_fleet_asset" />
        <field name="sequence">30</field>
        <field name="implied_by_ids" eval="[(4, ref('group_fleet_asset_user'))]" />
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]" />
    </record>
</odoo>