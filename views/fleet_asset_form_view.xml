<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <!-- Fleet Asset Form View -->
    <record id="fleet_asset_form_view" model="ir.ui.view">
        <field name="name">Fleet Asset Form</field>
        <field name="model">fleet.asset</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="asset_type" />
                            <field name="assigned_employee_id" />
                            <field name="service_intervals_days" />
                        </group>
                        <group>
                            <field name="license_plate" invisible="asset_type != 'vehicle'" />
                            <field name="last_service_date" />
                            <field name="next_service_date" />
                            <field name="is_overdue" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Service History">
                            <field name="service_history_ids">
                                <list editable="bottom">
                                    <field name="service_date" />
                                    <field name="cost" />
                                    <field name="notes" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>