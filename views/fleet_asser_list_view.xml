<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <!-- Fleet Asset List View -->
    <record id="fleet_asset_list_view" model="ir.ui.view">
        <field name="name">Fleet Asset List</field>
        <field name="model">fleet.asset</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="asset_type" />
                <field name="assigned_employee_id" />
                <field name="service_intervals_days" />
                <field name="last_service_date" />
                <field name="next_service_date" />
            </list>
        </field>
    </record>
</odoo>