<?xml version="1.0" encoding="UTF-8"?>

<odoo>
    <!-- Fleet Service Form View -->
    <record id="fleet_service_form_view" model="ir.ui.view">
        <field name="name">Fleet Service Form</field>
        <field name="model">fleet.service</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_done" string="Mark Done" type="object"
                        class="btn-primary" />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="asset_id" />
                            <field name="service_date" />
                            <field name="service_type" />
                        </group>
                        <group>
                            <field name="cost" />
                            <field name="technician_id" />
                            <field name="state" />
                            <field name="notes" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>